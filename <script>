<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KariPop - Sort Balls</title>
    <style>
        /* Fondo: Noche Estrellada de Van Gogh */
        body {
            background-image: url('https://upload.wikimedia.org/wikipedia/commons/thumb/e/ea/Van_Gogh_-_Starry_Night_-_Google_Art_Project.jpg/1280px-Van_Gogh_-_Starry_Night_-_Google_Art_Project.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            color: #f0f0f0;
            overflow: hidden;
        }

        h1 {
            color: #fff;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.8);
        }

        #game-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
            padding: 20px;
            background-color: rgba(0, 0, 0, 0.6);
            border-radius: 15px;
            box-shadow: 0 0 20px rgba(0,0,0,0.5);
        }

        #level-indicator {
            font-size: 1.5em;
            font-weight: bold;
            color: #FFD700;
            text-shadow: 1px 1px 2px black;
        }

        #tubes-container {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
            max-width: 800px;
        }

       .tube {
            width: 60px;
            height: 240px;
            border: 3px solid #ccc;
            border-radius: 0 0 30px 30px;
            background: linear-gradient(to right, rgba(255,255,255,0.1), rgba(255,255,255,0.3));
            display: flex;
            flex-direction: column-reverse;
            padding: 5px;
            cursor: pointer;
            transition: transform 0.2s;
        }

       .tube:hover {
            transform: translateY(-5px);
        }

       .tube.selected {
            border-color: #FFD700;
            box-shadow: 0 0 15px #FFD700;
        }

        /* Estilos de los avatares/bolitas */
       .ball {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            margin: 2px auto;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 28px;
            border: 2px solid rgba(255,255,255,0.5);
            box-shadow: inset 0 0 10px rgba(0,0,0,0.3);
            transition: transform 0.3s ease-in-out;
        }

       .avatar-flower { background: linear-gradient(145deg, #ff9a9e, #fecfef); }
       .avatar-cherry { background: linear-gradient(145deg, #ff758c, #ff7eb3); }
       .avatar-cheese { background: linear-gradient(145deg, #ffe259, #ffa751); }
       .avatar-rabbit { background: linear-gradient(145deg, #a1c4fd, #c2e9fb); }

        #start-screen {
            text-align: center;
        }

       .avatar-button {
            font-size: 20px;
            padding: 15px 25px;
            margin: 10px;
            cursor: pointer;
            border-radius: 10px;
            border: 2px solid white;
            background-color: rgba(255,255,255,0.2);
            color: white;
            transition: all 0.3s;
        }
       .avatar-button:hover {
            background-color: rgba(255,255,255,0.4);
            transform: scale(1.05);
        }

        #game-board {
            display: none;
        }
    </style>
</head>
<body>
    <div id="game-container">
        <h1>KariPop ✨</h1>
        <div id="level-indicator">Nivel: <span id="level-number">1</span></div>
        
        <div id="start-screen">
            <h2>Elige tu avatar</h2>
            <button class="avatar-button" onclick="startGame('Dayana')">🌸 Daya</button>
            <button class="avatar-button" onclick="startGame('Cristi')">🍒 Cristi</button>
            <button class="avatar-button" onclick="startGame('Beita')">🧀 Beita</button>
            <button class="avatar-button" onclick="startGame('Kari')">🐰 Kari</button>
        </div>

        <div id="game-board">
            <div id="tubes-container"></div>
        </div>
    </div>

<script>
    // LOS 4 AVATARES CON NOMBRES
    const avataresConfig = [
    { type: 'Dayana', emoji: '🌸', class: 'avatar-flower', name: 'Daya' },
    { type: 'Cristi', emoji: '🍒', class: 'avatar-cherry', name: 'Cristi' },
    { type: 'Beita', emoji: '🧀', class: 'avatar-cheese', name: 'Beita' },
    { type: 'Kari', emoji: '🐰', class: 'avatar-rabbit', name: 'Kari' }
    ];

    const TUBE_CAPACITY = 4;
    let gameState = 'menu';
    let currentLevel = 1;
    let levelData = [];
    let selectedTube = null;
    let isAnimating = false;

    function startGame(avatarType) {
        document.getElementById('start-screen').style.display = 'none';
        document.getElementById('game-board').style.display = 'block';
        gameState = 'playing';
        generarNivel();
        renderGame();
    }

    function generarNivel() {
        levelData = [];
        const numTubes = 8;
        for (let i = 0; i < numTubes - 2; i++) {
            levelData.push([]);
        }
        levelData.push([]);
        levelData.push([]);

        const balls = [];
        avataresConfig.forEach(avatar => {
            for (let i = 0; i < TUBE_CAPACITY; i++) {
                balls.push({type: avatar.type, emoji: avatar.emoji, class: avatar.class});
            }
        });
        
        balls.sort(() => Math.random() - 0.5);

        let ballIndex = 0;
        for (let i = 0; i < levelData.length - 2; i++) {
            for (let j = 0; j < TUBE_CAPACITY; j++) {
                if (ballIndex < balls.length) {
                    levelData[i].push(balls[ballIndex]);
                    ballIndex++;
                }
            }
        }
    }

    function renderGame() {
        const container = document.getElementById('tubes-container');
        container.innerHTML = '';
        document.getElementById('level-number').innerText = currentLevel;

        levelData.forEach((tube, tubeIndex) => {
            const tubeDiv = document.createElement('div');
            tubeDiv.classList.add('tube');
            tubeDiv.dataset.index = tubeIndex;
            if (selectedTube === tubeIndex) {
                tubeDiv.classList.add('selected');
            }
            tubeDiv.onclick = () => handleTubeClick(tubeIndex);

            tube.forEach(ball => {
                const ballDiv = document.createElement('div');
                ballDiv.classList.add('ball', ball.class);
                ballDiv.innerText = ball.emoji;
                tubeDiv.appendChild(ballDiv);
            });
            container.appendChild(tubeDiv);
        });
    }

    function handleTubeClick(index) {
        if (isAnimating || gameState!== 'playing') return;

        if (selectedTube === null) {
            if (levelData[index].length > 0) {
                selectedTube = index;
                renderGame();
            }
        } else {
            if (selectedTube!== index) {
                moverBola(selectedTube, index);
            }
            selectedTube = null;
            renderGame();
        }
    }

    function moverBola(origen, destino) {
        isAnimating = true;
        const tubeOrigen = levelData[origen];
        const tubeDestino = levelData[destino];
        const bola = tubeOrigen[tubeOrigen.length - 1];

        if (tubeDestino.length < TUBE_CAPACITY && (tubeDestino.length === 0 || tubeDestino[tubeDestino.length - 1].type === bola.type)) {
            tubeOrigen.pop();
            tubeDestino.push(bola);
        }
        
        setTimeout(() => {
            isAnimating = false;
            checkWin();
            renderGame();
        }, 300);
    }

    function checkWin() {
        const win = levelData.every(tube => 
            tube.length === 0 || 
            (tube.length === TUBE_CAPACITY && tube.every(ball => ball.type === tube[0].type))
        );
        if (win) {
            alert('¡Ganaste Nivel ' + currentLevel + '!');
            currentLevel++;
            generarNivel();
        }
    }
</script>
</body>
</html>
